# Sample Size Calculator - Environment Configuration
# Copy this file to .env and adjust values as needed

# Application Port
# The port on which the web interface will be accessible
# Default: 8080
PORT=8080

# Logging Configuration
# Log level for application logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Default: INFO
LOG_LEVEL=INFO

# Log Retention Period
# Number of days to retain audit log files before rotation/deletion
# Requirement 38.10: Minimum 90 days retention for QMS compliance
# Default: 90
LOG_RETENTION_DAYS=90

# Reports Directory
# Base directory for storing generated PDF reports
# Subdirectories will be created for validation, calculations, and full reports
# Default: ./reports
REPORTS_DIR=./reports
